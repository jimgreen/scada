<table_info>
@   table_id     table_name_eng     table_name_chn     app_type     max_record_num     down_load     is_model     module_name
#   720         fes_channel_can_define              CAN通道参数定义表           public/fes/scada 200 1 0 scada
</table_info>
<fes_channel_can_define>
@   column_id     column_name_eng     column_name_chn     data_type     data_length     is_key     app_type     display_type     menu_name
#   1             channel_id                         所属通道                          INT       8            1        public/fes/scada KEYID类型
#   3             name                           中文名称                           STRING     256          0        public/fes/scada STRING
#   5             interface                      CAN接口                          STRING     256          0        public/fes/scada STRING
#   6             channel                        CAN通道                          STRING     256          0        public/fes/scada STRING
#   7             bitrate                        仲裁段波特率                         INT       8            0        public/fes/scada INT
#   8             data_bitrate                   数据段波特率                         INT       8            0        public/fes/scada INT
#   9             fd                             CAN-FD                         INT       8            0        public/fes/scada 单选菜单           二值判断
#   10            receive_own_messages           接收自身报文                         INT       8            0        public/fes/scada 单选菜单           二值判断
#   11            receive_timeout                接收超时（秒）                        FLOAT      8            0        public/fes/scada FLOAT
#   12            retry_count                    重试次数                           INT       8            0        public/fes/scada INT
#   13            is_extended_id                 扩展帧默认值                         INT       8            0        public/fes/scada 单选菜单           二值判断
#   14            sample_point                   仲裁段采样点（百分比）                    FLOAT      8            0        public/fes/scada FLOAT
#   15            data_sample_point              数据段采样点（百分比）                    FLOAT      8            0        public/fes/scada FLOAT
#   16            bitrate_switch                 默认BRS数据相位切换                    INT       8            0        public/fes/scada 单选菜单           二值判断
#   17            restart_on_error               错误自动恢复                         INT       8            0        public/fes/scada 单选菜单           二值判断
#   18            bus_off_recovery_ms            Bus-off恢复等待（毫秒）                INT       8            0        public/fes/scada INT
#   19            receive_error_frames           接收错误帧                          INT       8            0        public/fes/scada 单选菜单           二值判断
</fes_channel_can_define>
