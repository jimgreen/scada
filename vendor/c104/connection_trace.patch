+void Server::enableConnectionTrace(bool enabled) {
+  connectionTraceEnabled.store(enabled);
+}
+
+void Server::recordConnectionTrace(IMasterConnection connection, int kind,
+                                   const uint8_t *data, int size) {
+  if (!connectionTraceEnabled.load()) return;
+  char peer[100] = {};
+  IMasterConnection_getPeerAddress(connection, peer, sizeof(peer));
+  std::lock_guard<std::mutex> lock(connectionTraceMutex);
+  auto found = traceConnectionIds.find(connection);
+  if (found == traceConnectionIds.end())
+    found = traceConnectionIds.emplace(connection, ++traceNextId).first;
+  const auto id = found->second;
+  if (connectionTraceEvents.size() >= 32768) {
+    ++traceDropped;
+  } else {
+    ConnectionTraceEvent event{id, kind,
+      std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count(), peer, {}};
+    if (data && size > 0) event.data.assign(data, data + size);
+    connectionTraceEvents.push_back(std::move(event));
+  }
+  if (kind == 11) traceConnectionIds.erase(connection);
+}
+
+py::list Server::drainConnectionTrace() {
+  std::deque<ConnectionTraceEvent> events;
+  uint64_t dropped;
+  {
+    std::lock_guard<std::mutex> lock(connectionTraceMutex);
+    events.swap(connectionTraceEvents);
+    dropped = traceDropped;
+    traceDropped = 0;
+  }
+  py::list result;
+  if (dropped) result.append(py::make_tuple(0, 99, 0, "", py::bytes(), dropped));
+  for (const auto &event : events) {
+    result.append(py::make_tuple(event.id, event.kind, event.time, event.peer,
+      py::bytes(reinterpret_cast<const char *>(event.data.data()), event.data.size()), 0));
+  }
+  return result;
+}
