+bool
+CS104_Connection_isTransmitIdle(IMasterConnection connection)
+{
+    MasterConnection con = (MasterConnection) connection->object;
+    bool idle;
+#if (CONFIG_USE_SEMAPHORES == 1)
+    Semaphore_wait(con->sentASDUsLock);
+#endif
+    /* Same lock order as sendNextHighPriorityASDU: no queue-to-k-buffer gap. */
+    HighPriorityASDUQueue_lock(con->highPrioQueue);
+    idle = con->oldestSentASDU == -1 && con->highPrioQueue->entryCounter == 0;
+    HighPriorityASDUQueue_unlock(con->highPrioQueue);
+#if (CONFIG_USE_SEMAPHORES == 1)
+    Semaphore_post(con->sentASDUsLock);
+#endif
+    return idle;
+}
