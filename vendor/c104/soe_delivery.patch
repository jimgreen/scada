+bool Server::submitSoe(const std::vector<std::string> &asdus) {
+  if (asdus.empty() || asdus.size() > 512)
+    throw std::invalid_argument("SOE batch must contain 1..512 ASDUs");
+  for (const auto &data : asdus) {
+    if (data.size() < 17 || data.size() > 249)
+      throw std::invalid_argument("Invalid SOE ASDU length");
+    auto p = reinterpret_cast<const uint8_t *>(data.data());
+    size_t n = p[1] & 127;
+    if ((p[0] != 30 && p[0] != 31) || !n || (p[2] & 127) != 3 ||
+        data.size() != 6 + ((p[1] & 128) ? 3 : n * 3) + n * 8)
+      throw std::invalid_argument("SOE requires well-formed spontaneous CP56 SP/DP");
+  }
+  Module::ScopedGilRelease const scoped("Server.submit_soe");
+  std::lock_guard<Module::GilAwareMutex> const lock(connection_mutex);
+  if (!enabled || !soeRecipients.empty()) return false;
+  for (const auto &entry : connectionMap)
+    if (entry.second) soeRecipients[entry.first] = connectionEpochs.at(entry.first);
+  if (soeRecipients.empty()) return false;
+  soeFailed = false;
+  for (const auto &data : asdus) {
+    auto asdu = CS101_ASDU_createFromBuffer(appLayerParameters,
+        reinterpret_cast<uint8_t *>(const_cast<char *>(data.data())), data.size());
+    if (!asdu) { soeFailed = true; break; }
+    for (const auto &entry : soeRecipients) {
+      if (!IMasterConnection_sendASDU(entry.first, asdu)) soeFailed = true;
+    }
+    CS101_ASDU_destroy(asdu);
+    if (soeFailed) break;
+  }
+  // Even a partially submitted batch must be drained/polled before retrying.
+  return true;
+}
+
+int Server::pollSoe() {
+  Module::ScopedGilRelease const scoped("Server.poll_soe");
+  std::lock_guard<Module::GilAwareMutex> const lock(connection_mutex);
+  if (soeRecipients.empty()) return -1;
+  bool idle = true;
+  for (const auto &entry : soeRecipients) {
+    auto current = connectionEpochs.find(entry.first);
+    auto state = connectionMap.find(entry.first);
+    if (!enabled || current == connectionEpochs.end() || current->second != entry.second ||
+        state == connectionMap.end() || !state->second) {
+      soeRecipients.clear();
+      return -1;
+    }
+    if (!CS104_Connection_isTransmitIdle(entry.first)) idle = false;
+  }
+  if (!idle) return 0;
+  soeRecipients.clear();
+  return soeFailed ? -1 : 1;
 }
 
