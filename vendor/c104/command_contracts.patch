 using namespace Remote;
 using namespace std::chrono_literals;
 
+namespace {
+// Bounded queues must fit common multi-thousand-point GI/spontaneous bursts.
+// The upstream 100-ASDU limit can overwrite queued objects within one Batch.
+constexpr int SCADA_MESSAGE_QUEUE_CAPACITY = 1024;
+// Compare IOA, value and qualifier, excluding S/E and the CP56 timestamp.
+// A selection authorizes one command value from one connection/originator.
+bool matchesSelectedCommand(CS101_ASDU selected, CS101_ASDU command) {
+  const auto type = CS101_ASDU_getTypeID(command);
+  if (CS101_ASDU_getTypeID(selected) != type ||
+      CS101_ASDU_getOA(selected) != CS101_ASDU_getOA(command))
+    return false;
+  int size = 0;
+  switch (type) {
+  case C_SC_NA_1: case C_DC_NA_1: case C_RC_NA_1:
+  case C_SC_TA_1: case C_DC_TA_1: case C_RC_TA_1: size = 4; break;
+  case C_SE_NA_1: case C_SE_NB_1:
+  case C_SE_TA_1: case C_SE_TB_1: size = 6; break;
+  case C_SE_NC_1: case C_SE_TC_1: size = 8; break;
+  default: return false;
+  }
+  if (CS101_ASDU_getPayloadSize(selected) < size ||
+      CS101_ASDU_getPayloadSize(command) < size)
+    return false;
+  auto a = CS101_ASDU_getPayload(selected);
+  auto b = CS101_ASDU_getPayload(command);
+  for (int i = 0; i < size; ++i) {
+    const unsigned mask = i == size - 1 ? 0x7f : 0xff;
+    if ((a[i] & mask) != (b[i] & mask)) return false;
+  }
+  return true;
+}
+}
